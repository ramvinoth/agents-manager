[Unit]
Description=Harman LFM3-Audio call voice (GPU 1)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/harman-lfm3
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1
Environment=HARMAN_LFM3_PORT=8098
ExecStart=%h/lfm3-exp/venv/bin/python %h/harman-lfm3/lfm3_service.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
