[Unit]
Description=Orchestrator Nemotron turn-based audio (GPU-isolated)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agents-voicechat
EnvironmentFile=%h/agents-voicechat/service.env
ExecStart=%h/agents-voicechat/venv/bin/python %h/agents-voicechat/voicechat_service.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
