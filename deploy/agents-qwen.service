[Unit]
Description=Orchestrator Qwen-TTS service (Qwen3-TTS-1.7B on GPU, A/B voice)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/agents-qwen
Environment=CUDA_VISIBLE_DEVICES=1
Environment=AGENTS_QWEN_PORT=8096
Environment=AGENTS_QWEN_SPEAKER=aiden
Environment=AGENTS_QWEN_LANG=English
Environment=AGENTS_STT_URL=http://127.0.0.1:8095/transcribe
ExecStart=%h/qwen3-tts-env/bin/python %h/agents-qwen/qwen_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
