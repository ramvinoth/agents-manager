[Unit]
Description=Harman Qwen-TTS service (Qwen3-TTS-1.7B on GPU, A/B voice)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/harman-qwen
Environment=CUDA_VISIBLE_DEVICES=1
Environment=HARMAN_QWEN_PORT=8096
Environment=HARMAN_QWEN_SPEAKER=aiden
Environment=HARMAN_QWEN_LANG=English
Environment=HARMAN_STT_URL=http://127.0.0.1:8095/transcribe
ExecStart=%h/qwen3-tts-env/bin/python %h/harman-qwen/qwen_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
