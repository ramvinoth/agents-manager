[Unit]
Description=Manager Pocket-TTS service (kyutai/pocket-tts, fast conversational voice)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/agents-pocket
Environment=CUDA_VISIBLE_DEVICES=3
Environment=AGENTS_POCKET_DEVICE=cuda
Environment=AGENTS_POCKET_PORT=8097
Environment=AGENTS_POCKET_VOICE=george
Environment=AGENTS_STT_URL=http://127.0.0.1:8095/transcribe
ExecStart=%h/pocket-tts-env/bin/python %h/agents-pocket/pocket_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
