[Unit]
Description=Harman auto-update: install the newest signed release from the private feed
After=network-online.target harman-viewer.service
Wants=network-online.target

[Service]
Type=oneshot
# Rewritten to the service user by deploy/lib.sh hm_service_install; it needs
# the same rights as a manual `harman update` (passwordless sudo for systemctl).
User=harman
ExecStart=/usr/local/bin/harman auto-update
# A slow build plus the up-to-10-minute quiet wait must not be killed mid-swap.
TimeoutStartSec=2h
