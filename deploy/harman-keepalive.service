[Unit]
Description=Harman keep-alive front for the model gateway (stops Cloudflare 524s on long prompts)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/harman-keepalive
Environment=HARMAN_KA_LISTEN=127.0.0.1:8079
Environment=HARMAN_KA_UPSTREAM=http://127.0.0.1:8080
ExecStart=/usr/bin/python3 %h/harman-keepalive/gateway_keepalive.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
