[Unit]
Description=Manager auto-update: install the newest signed release from the private feed
After=network-online.target agents-viewer.service
Wants=network-online.target

[Service]
Type=oneshot
# Rewritten to the service user by deploy/lib.sh hm_service_install; it needs
# the same rights as a manual `agents update` (passwordless sudo for systemctl).
User=agents
ExecStart=/usr/local/bin/agents auto-update
# A slow build plus the up-to-10-minute quiet wait must not be killed mid-swap.
TimeoutStartSec=2h
