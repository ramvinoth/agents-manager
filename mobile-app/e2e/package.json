{
  "name": "agents-mobile-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Appium + WebdriverIO end-to-end tests for the Agents mobile app",
  "scripts": {
    "android": "wdio run wdio.android.conf.js",
    "ios": "wdio run wdio.ios.conf.js",
    "drivers": "npm run drivers:ios && npm run drivers:android",
    "drivers:ios": "APPIUM_HOME=\"$PWD/.appium\" appium driver install xcuitest@10.23.2",
    "drivers:android": "APPIUM_HOME=\"$PWD/.appium\" appium driver install uiautomator2@5.0.0"
  },
  "devDependencies": {
    "@wdio/appium-service": "^8.40.0",
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "appium": "3.7.0",
    "appium-xcuitest-driver": "10.23.2",
    "webdriverio": "^8.40.0"
  }
}
