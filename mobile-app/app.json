{
  "expo": {
    "name": "Agents",
    "slug": "agents-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "agents",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1B19"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suhai.agents",
      "buildNumber": "1791768533",
      "infoPlist": {
        "CFBundleDisplayName": "Harman",
        "NSMicrophoneUsageDescription": "Harman uses the microphone so you can talk to the agent in voice mode.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.suhai.agents",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D1B19"
      },
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Harman uses the camera to scan the pairing QR code and to take photos or videos you send to the agent.",
          "microphonePermission": "Harman uses the microphone so you can talk to the agent in voice mode.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Harman reads your photos and videos so you can send them to the agent.",
          "cameraPermission": "Harman uses the camera to take photos or videos you send to the agent.",
          "microphonePermission": "Harman uses the microphone so you can record video with sound to send to the agent."
        }
      ],
      [
        "@config-plugins/react-native-callkeep",
        {
          "appName": "Harman"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Harman uses the microphone so you can talk to the agent in voice mode."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D1B19"
        }
      ],
      "./plugins/withAndroidPermissions",
      "./plugins/withAndroidUploadSigning"
    ]
  }
}
